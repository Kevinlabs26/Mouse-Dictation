{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mouse Dictation",
  "version": "0.1.10",
  "identifier": "com.mousedictation.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Mouse Dictation",
        "width": 620,
        "height": 720,
        "minWidth": 620,
        "minHeight": 560,
        "maxWidth": 620,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEUxNjdDMzcxQjI1ODc2QTUKUldTbGRsaXljY05uNGNYR1loQ1p2c3F1YlY4c3pRbG9qalZ3VVJSMGl3SFl0cmQyZm9hWVQ4UFkK",
      "endpoints": [
        "https://github.com/Kevinlabs26/Mouse-Dictation/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
