{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mouse Dictation",
  "version": "0.1.6",
  "identifier": "com.mousedictation.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Mouse Dictation",
        "width": 620,
        "height": 720,
        "minWidth": 620,
        "minHeight": 560,
        "maxWidth": 620,
        "resizable": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png", "icons/icon.ico"]
  }
}
