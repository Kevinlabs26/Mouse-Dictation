{
  "build": {
    "beforeBundleCommand": "npm run verify:native"
  },
  "bundle": {
    "targets": [
      "app",
      "dmg"
    ],
    "createUpdaterArtifacts": false,
    "macOS": {
      "minimumSystemVersion": "15.5",
      "signingIdentity": "-",
      "entitlements": "Entitlements.plist",
      "frameworks": [
        "target/macos-native/libsherpa-onnx-c-api.dylib",
        "target/macos-native/libsherpa-onnx-cxx-api.dylib",
        "target/macos-native/libonnxruntime.dylib"
      ]
    }
  },
  "app": {
    "macOSPrivateApi": true
  }
}
